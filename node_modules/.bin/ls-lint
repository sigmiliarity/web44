#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/work/web44/web44/node_modules/.pnpm/@ls-lint+ls-lint@2.3.1/node_modules/@ls-lint/ls-lint/node_modules:/home/runner/work/web44/web44/node_modules/.pnpm/@ls-lint+ls-lint@2.3.1/node_modules:/home/runner/work/web44/web44/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/work/web44/web44/node_modules/.pnpm/@ls-lint+ls-lint@2.3.1/node_modules/@ls-lint/ls-lint/node_modules:/home/runner/work/web44/web44/node_modules/.pnpm/@ls-lint+ls-lint@2.3.1/node_modules:/home/runner/work/web44/web44/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@ls-lint/ls-lint/bin/cli.js" "$@"
else
  exec node  "$basedir/../@ls-lint/ls-lint/bin/cli.js" "$@"
fi
